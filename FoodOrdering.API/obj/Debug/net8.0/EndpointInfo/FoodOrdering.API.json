{
  "openapi": "3.0.1",
  "info": {
    "title": "FoodOrdering API",
    "description": "Food Ordering Application APIs with JWT Authentication",
    "version": "v1"
  },
  "paths": {
    "/api/Auth/LoginAsync": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticates the user using email and password.\r\nGenerates and returns a JWT token upon successful login.",
        "requestBody": {
          "description": "Login request containing email and password.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/CurrentUser": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Retrieves details of the currently authenticated user.\r\nInformation is extracted from JWT token claims.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Admin/AddAsync": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Asynchronously adds a new food item to the system.",
        "requestBody": {
          "description": "Food item details.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFoodItemRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFoodItemRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFoodItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Admin/BulkInsertAsync": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Asynchronously inserts multiple food items into the system.",
        "requestBody": {
          "description": "List of food items.",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FoodItem"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FoodItem"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FoodItem"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Admin/UpdateAsync": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Asynchronously updates an existing food item.",
        "requestBody": {
          "description": "Updated food item information.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodItem"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodItem"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/FoodItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Admin/DeleteByGuidAsync/{foodItemGuid}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Asynchronously deletes a food item using its GUID.",
        "parameters": [
          {
            "name": "foodItemGuid",
            "in": "path",
            "description": "Food Item GUID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/User/GetAllAsync": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Asynchronously retrieves all available food items.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/User/GetAllPaginationAsync": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Asynchronously retrieves food items using pagination.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Current page number.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of records per page.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/User/GetFilteredAsync": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Asynchronously retrieves food items based on filter criteria.",
        "parameters": [
          {
            "name": "foodName",
            "in": "query",
            "description": "Food name filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Food category filter.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/User/GetByGuidAsync/{foodItemGuid}": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Asynchronously retrieves a food item using its GUID value.",
        "parameters": [
          {
            "name": "foodItemGuid",
            "in": "path",
            "description": "Food Item GUID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateFoodItemRequest": {
        "type": "object",
        "properties": {
          "foodName": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "FoodItem": {
        "required": [
          "category",
          "foodName"
        ],
        "type": "object",
        "properties": {
          "foodItemGuid": {
            "type": "string",
            "format": "uuid"
          },
          "foodName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "category": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "price": {
            "maximum": 10000,
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdOn": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "nullable": true
          },
          "updatedOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updatedBy": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter JWT Token. Example: Bearer {your token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}